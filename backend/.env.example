# Canonical resident vLLM; unset uses this local default.
STUDYDY_SEMANTIC_BASE_URL=http://127.0.0.1:8000
# Optional bearer token. Empty/unset sends no Authorization header.
STUDYDY_SEMANTIC_API_KEY=
# GPU-constrained operators may use an HTTPS origin (no /v1 suffix):
# STUDYDY_SEMANTIC_BASE_URL=https://semantic.example.com
